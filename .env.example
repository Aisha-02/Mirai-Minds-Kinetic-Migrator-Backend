PORT=4000

# --- AWS RDS (IAM auth) — matches:
# aws rds generate-db-auth-token --hostname $RDSHOST --port 5432 --username postgres --region ap-northeast-1
DB_AUTH=iam
RDSHOST=database-1-instance-1.c3eyk6cayb17.ap-northeast-1.rds.amazonaws.com
RDSPORT=5432
RDSUSER=postgres
RDSDATABASE=postgres
AWS_REGION=ap-northeast-1
DB_SSL=require

# Optional local/password fallback (used only when RDSHOST is unset or DB_AUTH=password)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000

# Uploads (optional)
# UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# --- AI comparison reports (default: Groq)
AI_REPORT_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_ID=llama-3.3-70b-versatile
# Alternatives: llama-3.1-8b-instant | gemma2-9b-it
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.2
# GROQ_TIMEOUT_MS=60000

# --- AI field validation rules (reuses Groq key by default)
# Optional overrides:
# GROK_API_KEY=
# GROK_BASE_URL=https://api.groq.com/openai/v1
# GROK_MODEL=llama-3.3-70b-versatile
# GROK_MAX_TOKENS=4096
# GROK_TEMPERATURE=0.3

# --- AWS Bedrock (optional fallback)
# AI_REPORT_PROVIDER=bedrock
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.2
# AWS_BEARER_TOKEN_BEDROCK=

# --- SAP OData metadata (business object schema / key fields)
# WARNING: demo host uses plain HTTP — Basic Auth credentials are not encrypted in transit.
# Prefer HTTPS or a private network tunnel; raise with SAP team if this stays HTTP-only.
SAP_ODATA_BASE_URL=http://sapdemo02.ymsl.in:8027/sap/opu/odata/sap/ZSB_BUSOBJ_CONFIG
SAP_ODATA_USERNAME=your-sap-username
SAP_ODATA_PASSWORD=your-sap-password
# --- Validation cleanup (Python Lambda)
# local = run backend/lambda/validation_rules_runner/lambda_function.py
# aws   = invoke VALIDATION_LAMBDA_FUNCTION_NAME
VALIDATION_LAMBDA_MODE=local
# VALIDATION_LAMBDA_FUNCTION_NAME=kinetic-validation-rules-runner
# VALIDATION_PYTHON=python

