PORT=4000

# --- AWS credentials (S3, Bedrock, optional RDS IAM auth)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2

# --- S3 file storage
# Systematic layout:
#   uploads/{userId}/{batchId}/preload|postload/{timestamp}-{filename}
#   validation-reports/{userId}/{sessionKey}/input|report/{filename}
FILE_STORAGE=s3
S3_BUCKET=mirai-minds-s3
S3_REGION=ap-southeast-2

# --- AWS RDS PostgreSQL
# Password auth (recommended when RDS IAM auth is not configured):
DB_AUTH=password
RDSHOST=miraimindsdb2.cnasikoay15v.ap-southeast-2.rds.amazonaws.com
RDSPORT=5432
RDSUSER=postgres
RDSDATABASE=postgres
RDSPASSWORD=
DB_SSL=require

# IAM auth alternative (requires RDS IAM auth enabled on the instance):
# DB_AUTH=iam
# RDSHOST=your-instance.region.rds.amazonaws.com
# RDSPORT=5432
# RDSUSER=postgres
# RDSDATABASE=postgres

# Optional local/password fallback:
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000

UPLOAD_MAX_BYTES=5242880

# --- Amazon Bedrock (Claude Sonnet 5)
AI_REPORT_PROVIDER=bedrock
AI_DETECTION_PROVIDER=bedrock
BEDROCK_REGION=ap-southeast-2
# Use apac profile for ap-southeast-2; us/eu/global profiles also available
BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-5-v1:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.2
AWS_BEARER_TOKEN_BEDROCK=

# --- SAP OData metadata
SAP_ODATA_BASE_URL=http://sapdemo02.ymsl.in:8027/sap/opu/odata/sap/ZSB_BUSOBJ_CONFIG
SAP_ODATA_USERNAME=your-sap-username
SAP_ODATA_PASSWORD=your-sap-password

# --- Validation cleanup (Python Lambda)
VALIDATION_LAMBDA_MODE=local
# VALIDATION_LAMBDA_FUNCTION_NAME=kinetic-validation-rules-runner
# VALIDATION_PYTHON=python
