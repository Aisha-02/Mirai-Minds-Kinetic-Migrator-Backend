PORT=4000

# --- AWS RDS (IAM auth) — matches:
# aws rds generate-db-auth-token --hostname $RDSHOST --port 5432 --username postgres --region ap-northeast-1
DB_AUTH=iam
RDSHOST=database-1-instance-1.c3eyk6cayb17.ap-northeast-1.rds.amazonaws.com
RDSPORT=5432
RDSUSER=postgres
RDSDATABASE=postgres
AWS_REGION=ap-northeast-1
DB_SSL=require

# Optional local/password fallback (used only when RDSHOST is unset or DB_AUTH=password)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
# Comma-separated frontend origins (must match the browser Origin header)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

UPLOAD_MAX_BYTES=5242880

# --- AWS credentials (Bedrock + other AWS services)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# Optional Bedrock API key (long-term key) — use instead of IAM when configured
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
# BEDROCK_API_KEY_NAME=your-bedrock-api-key-name

# --- Amazon Bedrock (AI reports, rule generation, business-object detection)
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.2
# BEDROCK_TIMEOUT_MS=60000
# BEDROCK_SAMPLE_SIZE=25
# BEDROCK_RULES_MAX_TOKENS=16384
# BEDROCK_RULES_BATCH_SIZE=6

# --- AWS S3 (required for file storage)
AWS_S3_BUCKET=mirai-minds-s3
# AWS_S3_SIGNED_URL_EXPIRES_SEC=900
# On EC2, omit access keys below — use the instance IAM role instead.

# --- SAP OData metadata (business object schema / key fields)
# WARNING: demo host uses plain HTTP — Basic Auth credentials are not encrypted in transit.
# Prefer HTTPS or a private network tunnel; raise with SAP team if this stays HTTP-only.
SAP_ODATA_BASE_URL=http://sapdemo02.ymsl.in:8027/sap/opu/odata/sap/ZSB_BUSOBJ_CONFIG
SAP_ODATA_USERNAME=your-sap-username
SAP_ODATA_PASSWORD=your-sap-password
# --- Internal Python services
# Shared secret for X-Internal-Service-Key (validation-engine and comparison-engine)
INTERNAL_SERVICE_KEY=change-me-internal
VALIDATION_ENGINE_URL=http://localhost:8001
# VALIDATION_ENGINE_TIMEOUT_MS=120000

# --- Validation cleanup (Python Lambda) — interactive cleanup session fallback
# local = run backend/lambda/validation_rules_runner/lambda_function.py
# aws   = invoke VALIDATION_LAMBDA_FUNCTION_NAME
VALIDATION_LAMBDA_MODE=local
# VALIDATION_LAMBDA_FUNCTION_NAME=kinetic-validation-rules-runner
# VALIDATION_PYTHON=python
